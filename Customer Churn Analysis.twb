            <column-instance column='[Churn Value]' derivation='Sum' name='[sum:Churn Value:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0299385701240832]' derivation='User' name='[usr:Calculation_0299385701240832:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
