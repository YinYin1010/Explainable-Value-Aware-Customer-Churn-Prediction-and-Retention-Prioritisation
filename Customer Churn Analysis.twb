          <datasource-dependencies datasource='federated.0rs4smj0cy8r8l1fmilp10uibl11'>
            <column caption='Churn Rate' datatype='real' name='[Calculation_0299385701240832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Churn Label] = &quot;Yes&quot; THEN 1&#10;    ELSE 0&#10;    END&#10;)&#10;/&#10;COUNT([CustomerID])' />
            </column>
            <column caption='Tenure Group' datatype='string' name='[Calculation_0299385719574531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tenure Months] &lt;= 6 THEN &quot;0–6 Months&quot;&#10;ELSEIF [Tenure Months] &lt;= 12 THEN &quot;7–12 Months&quot;&#10;ELSEIF [Tenure Months] &lt;= 24 THEN &quot;13–24 Months&quot;&#10;ELSEIF [Tenure Months] &lt;= 36 THEN &quot;25–36 Months&quot;&#10;ELSEIF [Tenure Months] &lt;= 48 THEN &quot;37–48 Months&quot;&#10;ELSEIF [Tenure Months] &lt;= 60 THEN &quot;49–60 Months&quot;&#10;ELSE &quot;61–72 Months&quot;&#10;END' />
            </column>
            <column datatype='string' name='[Churn Label]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Churn Value]' role='measure' type='quantitative' />
            <column caption='Customer ID' datatype='string' name='[CustomerID]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Tenure Months]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0299385719574531]' derivation='None' name='[none:Calculation_0299385719574531:nk]' pivot='key' type='nominal' />
            <column-instance column='[Churn Value]' derivation='Sum' name='[sum:Churn Value:qk]' pivot='key' type='quantitative' />
